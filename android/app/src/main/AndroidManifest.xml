<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 画面の表示と、ドライブへの送信に使う。カメラはGoogleのスキャナーが使うので、このアプリには不要 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ドライブのアプリ（の「ドライブ スキャン」ウィジェット）を見つけるため -->
    <queries>
        <package android:name="com.google.android.apps.docs" />
    </queries>

    <application
        android:label="かんたんスキャン"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 共有メニューでPDFを渡すときだけ使う -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="io.github.cooo521.kantanscan.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
